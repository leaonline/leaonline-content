{
  "env": {
    "COVERAGE": {
      "plugins": [
        [
          "istanbul",
          {
            "exclude": [
              "**/packages/**",
              "**/node_modules/**",
              "tests/**",
              "**/tests/**",
              "**/*.tests.js",
              "**/*.test.js"
            ]
          }
        ]
      ]
    }
  }
}
